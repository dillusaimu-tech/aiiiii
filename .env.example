# StudyMate AI - Environment Configuration

# Server Port (default: 5001)
PORT=5001

# AI Provider Configuration
# Choose ONE of the providers below. If none is provided, StudyMate AI automatically activates
# a fully functional academic Demo Mode with realistic educational responses and interactive tools.

# Option 1: Google Gemini API (Recommended for educational applications)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option 2: OpenAI API
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option 3: Groq API (Ultra-fast inference)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
